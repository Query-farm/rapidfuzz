# each rapidfuzz function is registered exactly once per signature
query I
SELECT count(*) FROM (
	SELECT function_name, parameter_types, count(*) AS n FROM duckdb_functions()
	WHERE function_name LIKE 'rapidfuzz_%'
	GROUP BY ALL
) WHERE n <> 1;
----
0

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%';
----
57

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%' AND len(list_filter(parameters, lambda p: p SIMILAR TO 'col[0-9]+')) > 0;
----
0

query R
SELECT rapidfuzz_ratio('this is a test', 'this is a test!');
----
96.55172413793103

# every function is documented for duckdb_functions() and the generated website reference
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%'
  AND (coalesce(description, '') = '' OR len(examples) = 0 OR NOT list_contains(categories, 'text_similarity'));
----
0

# the documented examples start with the function they document
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%' AND NOT starts_with(examples[1], function_name || '(');
----
0
