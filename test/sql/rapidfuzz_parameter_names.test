rapidfuzz_levenshtein_editops	[s1, s2]
rapidfuzz_levenshtein_normalized_distance	[s1, s2, insert_cost, delete_cost, replace_cost, score_cutoff]
rapidfuzz_levenshtein_normalized_similarity	[s1, s2, insert_cost, delete_cost, replace_cost, score_cutoff]
rapidfuzz_levenshtein_opcodes	[s1, s2]
rapidfuzz_levenshtein_similarity	[s1, s2, insert_cost, delete_cost, replace_cost, score_cutoff]
rapidfuzz_osa_distance	[s1, s2, score_cutoff]
