rapidfuzz_jaro_winkler_normalized_distance	[s1, s2, prefix_weight, score_cutoff]
rapidfuzz_jaro_winkler_normalized_similarity	[s1, s2, prefix_weight, score_cutoff]
rapidfuzz_jaro_winkler_similarity	[s1, s2, prefix_weight, score_cutoff]
rapidfuzz_lcs_seq_distance	[s1, s2, score_cutoff]
rapidfuzz_lcs_seq_normalized_distance	[s1, s2, score_cutoff]
