query IIRR
SELECT rapidfuzz_postfix_distance('postfix', 'pretext'), rapidfuzz_postfix_similarity('postfix', 'pretext'),
       rapidfuzz_postfix_normalized_distance('postfix', 'pretext'), rapidfuzz_postfix_normalized_similarity('postfix', 'pretext');
----
