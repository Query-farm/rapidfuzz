#
# Return types: character counts are BIGINT, everything else DOUBLE
#

query TTTTT
SELECT typeof(rapidfuzz_ratio('a', 'b')), typeof(rapidfuzz_levenshtein_distance('a', 'b')),
       typeof(rapidfuzz_levenshtein_similarity('a', 'b')), typeof(rapidfuzz_levenshtein_normalized_distance('a', 'b')),
       typeof(rapidfuzz_jaro_winkler_distance('a', 'b'));
----
DOUBLE	BIGINT	BIGINT	DOUBLE	DOUBLE

#
# NULL handling
#

query RRIR
SELECT rapidfuzz_ratio(NULL, 'a'), rapidfuzz_ratio('a', NULL), rapidfuzz_levenshtein_distance(NULL, NULL),
       rapidfuzz_jaro_similarity(NULL::VARCHAR, 'a');
----
NULL	NULL	NULL	NULL

statement ok
CREATE TABLE strings AS SELECT * FROM (VALUES ('kitten', 'sitting'), (NULL, 'sitting'), ('kitten', NULL), ('', '')) t(a, b);

query IIR
SELECT rapidfuzz_levenshtein_distance(a, b), rapidfuzz_levenshtein_distance(a, 'sitting'), rapidfuzz_ratio('kitten', b)
FROM strings;
----
3	3	61.53846153846154
NULL	NULL	61.53846153846154
NULL	3	NULL
0	7	0.0
