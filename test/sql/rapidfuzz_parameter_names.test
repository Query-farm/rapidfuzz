# name: test/sql/rapidfuzz_parameter_names.test
# description: duckdb_functions() reports the real parameter names, and calls stay positional
# group: [sql]

require rapidfuzz

query TT
SELECT DISTINCT function_name, parameters FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%'
ORDER BY function_name;
----
rapidfuzz_hamming_distance	[s1, s2]
rapidfuzz_hamming_normalized_distance	[s1, s2]
rapidfuzz_hamming_normalized_similarity	[s1, s2]
rapidfuzz_hamming_similarity	[s1, s2]
rapidfuzz_indel_distance	[s1, s2]
rapidfuzz_indel_normalized_distance	[s1, s2]
rapidfuzz_indel_normalized_similarity	[s1, s2]
rapidfuzz_indel_similarity	[s1, s2]
rapidfuzz_jaro_distance	[s1, s2]
rapidfuzz_jaro_normalized_distance	[s1, s2]
rapidfuzz_jaro_normalized_similarity	[s1, s2]
rapidfuzz_jaro_similarity	[s1, s2]
rapidfuzz_jaro_winkler_distance	[s1, s2]
rapidfuzz_jaro_winkler_normalized_distance	[s1, s2]
rapidfuzz_jaro_winkler_normalized_similarity	[s1, s2]
rapidfuzz_jaro_winkler_similarity	[s1, s2]
rapidfuzz_lcs_seq_distance	[s1, s2]
rapidfuzz_lcs_seq_normalized_distance	[s1, s2]
rapidfuzz_lcs_seq_normalized_similarity	[s1, s2]
rapidfuzz_lcs_seq_similarity	[s1, s2]
rapidfuzz_osa_distance	[s1, s2]
rapidfuzz_osa_normalized_distance	[s1, s2]
rapidfuzz_osa_normalized_similarity	[s1, s2]
rapidfuzz_osa_similarity	[s1, s2]
rapidfuzz_partial_ratio	[s1, s2]
rapidfuzz_partial_token_set_ratio	[s1, s2]
rapidfuzz_postfix_distance	[s1, s2]
rapidfuzz_postfix_normalized_distance	[s1, s2]
rapidfuzz_postfix_normalized_similarity	[s1, s2]
rapidfuzz_postfix_similarity	[s1, s2]
rapidfuzz_prefix_distance	[s1, s2]
rapidfuzz_prefix_normalized_distance	[s1, s2]
rapidfuzz_prefix_normalized_similarity	[s1, s2]
