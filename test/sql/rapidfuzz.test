# name: test/sql/rapidfuzz.test
# description: Scores of every rapidfuzz scorer on reference inputs
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT rapidfuzz_ratio('a', 'b');
----
Catalog Error: Scalar Function with name rapidfuzz_ratio does not exist!

require rapidfuzz

#
# rapidfuzz.fuzz ratios (DOUBLE, 0 - 100)
#

query R
SELECT rapidfuzz_ratio('this is a test', 'this is a test!');
----
96.55172413793103

query R
SELECT rapidfuzz_partial_ratio('this is a test', 'this is a test!');
----
100.0

query R
SELECT rapidfuzz_token_sort_ratio('fuzzy wuzzy was a bear', 'wuzzy fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_partial_token_sort_ratio('fuzzy was a bear', 'wuzzy fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_token_set_ratio('fuzzy was a bear', 'fuzzy fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_partial_token_set_ratio('fuzzy was a bear', 'fuzzy fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_partial_token_set_ratio('fuzzy was a bear but not a dog', 'fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_token_ratio('fuzzy was a bear', 'wuzzy fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_partial_token_ratio('fuzzy was a bear', 'wuzzy fuzzy was a bear');
----
100.0

query R
SELECT rapidfuzz_wratio('this is a test', 'this is a new test!!!');
----
85.5

# QRatio scores empty strings as 0, ratio as 100
query RRR
SELECT rapidfuzz_qratio('this is a test', 'this is a new test!!!'), rapidfuzz_qratio('', ''), rapidfuzz_ratio('', '');
----
80.0	0.0	100.0

#
# Distance families: distance, similarity, normalized_distance, normalized_similarity
#

query IIRR
SELECT rapidfuzz_levenshtein_distance('kitten', 'sitting'), rapidfuzz_levenshtein_similarity('kitten', 'sitting'),
       rapidfuzz_levenshtein_normalized_distance('kitten', 'sitting'),
       rapidfuzz_levenshtein_normalized_similarity('kitten', 'sitting');
----
3	4	0.42857142857142855	0.5714285714285714

query IIRR
SELECT rapidfuzz_damerau_levenshtein_distance('ca', 'abc'), rapidfuzz_damerau_levenshtein_similarity('ca', 'abc'),
       rapidfuzz_damerau_levenshtein_normalized_distance('ca', 'abc'),
       rapidfuzz_damerau_levenshtein_normalized_similarity('ca', 'abc');
----
2	1	0.6666666666666666	0.33333333333333337

# OSA cannot edit a transposed pair again, so it needs one more edit than Damerau-Levenshtein here
query IIRR
SELECT rapidfuzz_osa_distance('ca', 'abc'), rapidfuzz_osa_similarity('ca', 'abc'),
       rapidfuzz_osa_normalized_distance('ca', 'abc'), rapidfuzz_osa_normalized_similarity('ca', 'abc');
----
3	0	1.0	0.0

query IIRR
SELECT rapidfuzz_osa_distance('postfix', 'pretext'), rapidfuzz_osa_similarity('postfix', 'pretext'),
       rapidfuzz_osa_normalized_distance('postfix', 'pretext'), rapidfuzz_osa_normalized_similarity('postfix', 'pretext');
----
5	2	0.7142857142857143	0.2857142857142857

query IIRR
SELECT rapidfuzz_indel_distance('kitten', 'sitting'), rapidfuzz_indel_similarity('kitten', 'sitting'),
       rapidfuzz_indel_normalized_distance('kitten', 'sitting'), rapidfuzz_indel_normalized_similarity('kitten', 'sitting');
----
5	8	0.38461538461538464	0.6153846153846154

query IIRR
SELECT rapidfuzz_lcs_seq_distance('postfix', 'pretext'), rapidfuzz_lcs_seq_similarity('postfix', 'pretext'),
       rapidfuzz_lcs_seq_normalized_distance('postfix', 'pretext'),
       rapidfuzz_lcs_seq_normalized_similarity('postfix', 'pretext');
----
4	3	0.5714285714285714	0.4285714285714286

query IIRR
SELECT rapidfuzz_hamming_distance('karolin', 'kathrin'), rapidfuzz_hamming_similarity('karolin', 'kathrin'),
       rapidfuzz_hamming_normalized_distance('karolin', 'kathrin'),
       rapidfuzz_hamming_normalized_similarity('karolin', 'kathrin');
----
3	4	0.42857142857142855	0.5714285714285714

query RRRR
SELECT rapidfuzz_jaro_distance('duck', 'duke'), rapidfuzz_jaro_similarity('duck', 'duke'),
       rapidfuzz_jaro_normalized_distance('duck', 'duke'), rapidfuzz_jaro_normalized_similarity('duck', 'duke');
----
0.16666666666666663	0.8333333333333334	0.16666666666666663	0.8333333333333334

query RRRR
