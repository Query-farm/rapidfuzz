0.1333333333333333	0.8666666666666667	0.1333333333333333	0.8666666666666667

query IIRR
SELECT rapidfuzz_prefix_distance('prefix', 'pretext'), rapidfuzz_prefix_similarity('prefix', 'pretext'),
       rapidfuzz_prefix_normalized_distance('prefix', 'pretext'), rapidfuzz_prefix_normalized_similarity('prefix', 'pretext');
----
