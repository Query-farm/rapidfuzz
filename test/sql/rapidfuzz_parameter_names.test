rapidfuzz_ratio	[s1, s2]
rapidfuzz_token_set_ratio	[s1, s2]
rapidfuzz_token_sort_ratio	[s1, s2]

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%' AND len(list_filter(parameters, lambda p: p SIMILAR TO 'col[0-9]+')) > 0;
----
0

query R
SELECT rapidfuzz_ratio('this is a test', 'this is a test!');
----
96.55172413793103
