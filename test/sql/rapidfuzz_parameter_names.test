# name: test/sql/rapidfuzz_parameter_names.test
# description: duckdb_functions() reports the parameter names, documentation and catalog of the extension
# group: [sql]

require rapidfuzz

query TT
SELECT function_name, parameters FROM duckdb_functions()
WHERE function_name LIKE 'rapidfuzz_%'
ORDER BY function_name;
----
rapidfuzz_damerau_levenshtein_distance	[s1, s2, score_cutoff]
rapidfuzz_damerau_levenshtein_normalized_distance	[s1, s2, score_cutoff]
rapidfuzz_damerau_levenshtein_normalized_similarity	[s1, s2, score_cutoff]
rapidfuzz_damerau_levenshtein_similarity	[s1, s2, score_cutoff]
rapidfuzz_extract	[query, choices, scorer, top_k, score_cutoff]
rapidfuzz_extract_one	[query, choices, scorer, score_cutoff]
rapidfuzz_hamming_distance	[s1, s2, pad, score_cutoff]
rapidfuzz_hamming_normalized_distance	[s1, s2, pad, score_cutoff]
rapidfuzz_hamming_normalized_similarity	[s1, s2, pad, score_cutoff]
rapidfuzz_hamming_similarity	[s1, s2, pad, score_cutoff]
rapidfuzz_indel_distance	[s1, s2, score_cutoff]
